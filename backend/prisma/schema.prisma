generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  users User[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([name])
  @@map("roles")
}

model User {
  id String @id @default(uuid())

  roleId String @map("role_id")
  role   Role   @relation(fields: [roleId], references: [id])

  firstName String @map("first_name")
  lastName  String @map("last_name")

  email String @unique

  passwordHash String @map("password_hash")

  status UserStatus @default(ACTIVE)

  lastLogin DateTime? @map("last_login")

  cashRegisters CashRegister[]
  movements     Movement[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([roleId])
  @@map("users")
}

enum ClientStatus {
  ACTIVE
  INACTIVE
}

model Client {
  id                   String       @id @default(uuid())
  identificationType   String       @map("identification_type")
  identificationNumber String       @unique @map("identification_number")
  firstName            String       @map("first_name")
  lastName             String       @map("last_name")
  phone                String?
  email                String?
  address              String?
  birthDate            DateTime?    @map("birth_date")
  status               ClientStatus @default(ACTIVE)
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  accounts             Account[]

  @@index([identificationNumber])
  @@map("clients")
}

enum AccountStatus {
  ACTIVE
  INACTIVE
}

model Account {
  id            String        @id @default(uuid())
  accountNumber String        @unique @map("account_number")
  clientId      String        @map("client_id")
  client        Client        @relation(fields: [clientId], references: [id])
  balance       Decimal       @default(0) @db.Decimal(12, 2)
  status        AccountStatus @default(ACTIVE)
  openedAt      DateTime      @default(now()) @map("opened_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  movements     Movement[]

  @@index([clientId])
  @@index([accountNumber])
  @@map("accounts")
}

enum CashRegisterStatus {
  OPEN
  CLOSED
}

enum MovementType {
  DEPOSIT
  WITHDRAWAL
}

model CashRegister {
  id             String             @id @default(uuid())
  userId         String             @map("user_id")
  user           User               @relation(fields: [userId], references: [id])
  openingBalance Decimal            @map("opening_balance") @db.Decimal(12, 2)
  closingBalance Decimal?           @map("closing_balance") @db.Decimal(12, 2)
  status         CashRegisterStatus @default(OPEN)
  openedAt       DateTime           @default(now()) @map("opened_at")
  closedAt       DateTime?          @map("closed_at")
  observations   String?

  movements      Movement[]

  @@index([userId])
  @@index([openedAt])
  @@map("cash_registers")
}

model Movement {
  id             String       @id @default(uuid())
  type           MovementType
  amount         Decimal      @db.Decimal(12, 2)
  
  accountId      String       @map("account_id")
  account        Account      @relation(fields: [accountId], references: [id])
  
  cashRegisterId String       @map("cash_register_id")
  cashRegister   CashRegister @relation(fields: [cashRegisterId], references: [id])
  
  userId         String       @map("user_id")
  user           User         @relation(fields: [userId], references: [id])
  
  observations   String?
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([accountId])
  @@index([cashRegisterId])
  @@index([createdAt])
  @@map("movements")
}
